{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiomlint:foundation:requirement:0.1",
  "title": "AxiomLint foundation requirement",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "pattern": "^WP-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "DRAFT",
        "IMPLEMENTED",
        "VERIFIED",
        "DEFERRED"
      ]
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "title",
    "source",
    "rationale",
    "owner",
    "package",
    "status",
    "verification",
    "evidence"
  ],
  "additionalProperties": false
}
