{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiomlint:governance:wp001-s1-delivery:0.1",
  "title": "Author S1 delivery, not readiness or audit approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "package", "stage", "actor",
               "context_id", "independent", "entry_commit", "scope_authorization",
               "constitution", "frozen_brief", "frozen_brief_sha256", "author_delivery",
               "formal_session_status", "readiness_approval", "independent_audit",
               "package_closure", "artifact_manifest", "handoff", "pin_receipt",
               "requirements", "criteria", "commands", "open_review_items", "constraints"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "session_id": {"const": "SESSION-WP-001-S1"},
    "package": {"const": "WP-001"},
    "stage": {"const": "S1"},
    "actor": {"const": "Computer implementation author"},
    "context_id": {"const": "72131cdc-563c-4d43-a6b3-f37dd1253e0c"},
    "independent": {"const": false},
    "entry_commit": {"const": "71a557223ec8c49c95e91fcb77429773358f0391"},
    "scope_authorization": {"const": "governance/approvals/APR-002-wp001-s1-scope.md"},
    "constitution": {"const": "governance/charter/ACTIVE-BASELINE.json"},
    "frozen_brief": {"const": "governance/session-briefs/WP-001/S1.md"},
    "frozen_brief_sha256": {"const": "eaf84b61a397e2588ad4bc1724a3069c60c00efea0db45df24689f6a5cf1e7a6"},
    "author_delivery": {"const": "ASSEMBLED_PENDING_PINNED_VERIFICATION"},
    "formal_session_status": {"const": "IN_PROGRESS"},
    "readiness_approval": {"const": "PENDING_SEPARATE_CONTEXT"},
    "independent_audit": {"const": "NOT_PERFORMED"},
    "package_closure": {"const": "NOT_GRANTED"},
    "artifact_manifest": {"const": "governance/execution/WP-001/S1/artifacts.json"},
    "handoff": {"const": "governance/execution/WP-001/S1/handoff.md"},
    "pin_receipt": {"const": "artifacts/wp001-s1/AUDIT-TARGET.json"},
    "requirements": {"const": ["REQ-GOV-001", "REQ-GOV-002", "REQ-GOV-003", "REQ-LIC-001"]},
    "criteria": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "criterion", "artifacts", "verification", "independent_assessment"],
        "properties": {
          "id": {"type": "string", "pattern": "^WP-001-C0[1-8]$"},
          "criterion": {"type": "string", "minLength": 1},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "string", "minLength": 1},
          "independent_assessment": {"const": "PENDING"}
        }
      }
    },
    "commands": {"type": "array", "minItems": 4, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "open_review_items": {"const": ["DEV-001", "DEV-002", "FIND-S1-001", "READINESS-D2-INTERPRETATION"]},
    "constraints": {"const": ["NO_HOSTED_CI", "NO_SELF_APPROVED_READINESS", "NO_INDEPENDENT_S2_CLAIM",
                              "NO_PACKAGE_OR_PHASE_CLOSURE", "NO_BACKEND_OR_SUBJECT_EXECUTION",
                              "NO_BENCHMARK_OR_EFFICACY_RESULT"]}
  }
}
